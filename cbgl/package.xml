<?xml version="1.0"?>
<package format="3">
  <name>cbgl</name>
  <version>1.0.1</version>
  <description>Global localisation of a 2D lidar sensor in a 2D occupancy grid, under global uncertainty in position and orientation, from a single scan.</description>
  <maintainer email="alefilot@auth.gr">li9i</maintainer>
  <license file="LICENSE">MIT</license>

  <url type="repository">https://github.com/cbgl/cbgl</url>
  <url type="bugtracker">https://github.com/cbgl/cbgl/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>fsm_localisation</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>csm</depend>
  <depend>libfftw3</depend>
  <depend>yaml-cpp</depend>
  <depend>pkg-config</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
